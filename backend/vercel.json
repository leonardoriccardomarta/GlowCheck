{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/index.ts": {
      "includeFiles": "public/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/health", "destination": "/api" },
    { "source": "/analyze", "destination": "/api" },
    { "source": "/auth/:path*", "destination": "/api" },
    { "source": "/shelf", "destination": "/api" },
    { "source": "/shelf/:path*", "destination": "/api" },
    { "source": "/billing", "destination": "/api" },
    { "source": "/billing/:path*", "destination": "/api" },
    { "source": "/admin", "destination": "/api" },
    { "source": "/admin/:path*", "destination": "/api" }
  ]
}
